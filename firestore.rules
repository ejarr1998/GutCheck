rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Per-user namespace: every account's data lives under users/{uid}/...
    // and is readable/writable ONLY by that signed-in uid. Any Google account
    // can sign up, but nobody can ever touch another uid's tree.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // TODO(ethan): DELETE THIS ENTIRE BLOCK once migration is verified and the
    // legacy collections are removed from the console. Until then it is a
    // standing admin-wide hole over those 7 collections — it exists solely so
    // the first-login migration can copy Ethan's data into users/{hisUid}/.
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn()
        && email() == "ejarr1998@gmail.com"
        && collection in ["weights", "photos", "meals", "measurements", "workouts", "chats", "settings"];
    }
  }
}
